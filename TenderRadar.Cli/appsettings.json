{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Ted": {
    "BaseUrl": "https://api.ted.europa.eu/",
    "TimeoutSeconds": 60,
    "PageLimit": 250,
    "LookbackDays": 7,
    "CpvCodes": [ "72000000", "48000000" ],
    "Fields": [
      "publication-number",
      "notice-title",
      "buyer-name",
      "buyer-country",
      "publication-date",
      "deadline-receipt-request",
      "classification-cpv",
      "total-value",
      "total-value-cur"
    ]
  },
  "Scoring": {
    "MinScore": 3,
    "CpvWeights": {
      "DirectHit": 5,
      "Development": 2,
      "General": 0
    },
    "Keywords": [
      { "Phrase": "product information management", "Weight": 5 },
      { "Phrase": "digital asset management", "Weight": 5 },
      { "Phrase": "PIM", "Weight": 5, "WholeWordOnly": true },
      { "Phrase": "DAM", "Weight": 5, "WholeWordOnly": true },
      { "Phrase": "e-commerce", "Weight": 3 },
      { "Phrase": "marketplace", "Weight": 3 },
      { "Phrase": "catalog management", "Weight": 3 },
      { "Phrase": "supplier portal", "Weight": 3 },
      { "Phrase": "order management", "Weight": 2 },
      { "Phrase": "middleware", "Weight": 2 },
      { "Phrase": "ERP integration", "Weight": 2 }
    ]
  }
}